# Copy to .env.local for development. Never commit real values.

# Public (safe in the browser): Supabase project URL and anon/publishable key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The site's public URL, used for auth email redirects and Paystack callbacks.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server only. Used by the Paystack webhook/verification and the admin bootstrap
# script. Never prefix with NEXT_PUBLIC_ and never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Paystack. The secret key is server only.
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
